# Copie este arquivo para ".env" e ajuste os valores.

NOME_ESCOLA=Minha Escola

# Planilha com as colunas: Aluno, Turma, Responsável, Telefone (Matrícula é opcional)
EXCEL_ALUNOS=dados/alunos.xlsx
DB_PATH=dados/pontuaedu.db

# Mostra alerta quando o aluno tem ALERTA_LIMITE atrasos ou mais nos últimos ALERTA_JANELA_DIAS dias
ALERTA_LIMITE=3
ALERTA_JANELA_DIAS=30

# Por quantos dias o funcionário fica conectado no app
SESSAO_DIAS=30

# ---------- WhatsApp ----------
# Provedor: twilio ou meta. Deixe as credenciais em branco para só registrar, sem enviar.
WHATSAPP_PROVEDOR=twilio

# Twilio (console.twilio.com > Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número que envia. O do Sandbox de testes é +14155238886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Opcional: SID (HX...) do modelo aprovado no Content Template Builder, com {{1}} aluno, {{2}} turma, {{3}} data/hora.
# Em branco, envia texto livre (funciona no Sandbox).
TWILIO_CONTENT_SID=

# WhatsApp Cloud API da Meta (só se WHATSAPP_PROVEDOR=meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aviso_atraso
WHATSAPP_IDIOMA=pt_BR
WHATSAPP_API_VERSAO=v23.0
